generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nome      String
  email     String     @unique
  senha     String
  produtos  Produto[]
  producoes Producao[]
}

model Produto {
  id            Int        @id @default(autoincrement())
  nome          String
  descricao     String?
  custo         Float
  quantidade    Int        @default(0)
  estoqueMinimo Int        @default(0)
  usuarioId     Int
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  producoes     Producao[]
}

model Producao {
  id         Int      @id @default(autoincrement())
  tipo       String
  quantidade Int
  status     String   @default("PENDENTE")
  data       DateTime
  produtoId  Int
  usuarioId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}